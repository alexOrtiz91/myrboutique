{
  "name": "myrboutique",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server run start",
    "build:client": "npm --prefix client run build",
    "preview:client": "npm --prefix client run preview",
    "db:status": "node db-status.js",
    "db:check-owner": "node db-check-owner.js",
    "db:migrate": "node migrate-db.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
